{
	"name": "smart-door-web-companion",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"prepare": "svelte-kit sync || echo ''",
		"dev": "vite dev",
		"build": "vite build && node scripts/csp.mjs",
		"preview": "vite preview",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"lint": "node scripts/lint.mjs",
		"themes": "node scripts/check-themes.mjs",
		"test": "vitest run",
		"budget": "node scripts/budget.mjs",
		"hw": "node hardware-tests/run.mjs",
		"gate": "npm run check && npm run lint && npm run themes && npm run test && npm run budget"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@types/node": "^26.3.0",
		"jsdom": "^30.0.1",
		"svelte": "^5.0.0",
		"svelte-check": "^4.2.0",
		"typescript": "^5.8.0",
		"vite": "^7.0.0",
		"vitest": "^3.2.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true
	}
}

menu "SDF Platform Configuration"

config SDF_PLATFORM_ENABLE_LIGHT_SLEEP
    bool "Enable light sleep support"
    default y
    help
        Enable light sleep power management features.

config SDF_PLATFORM_ENABLE_DEEP_SLEEP
    bool "Enable deep sleep support"
    default n
    help
        Enable deep sleep power management features (requires RTC GPIO support).

config SDF_PLATFORM_NVS_ENCRYPTION
    bool "Require NVS encryption at boot"
    default y
    help
        Verify NVS encryption is enabled and keys partition exists at startup.

config SDF_PLATFORM_WDT_TIMEOUT_MS
    int "Task watchdog timeout (ms)"
    default 15000
    range 5000 60000
    help
        Task watchdog timeout in milliseconds.

endmenu